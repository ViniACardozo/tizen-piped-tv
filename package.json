{
  "name": "tizen-piped-tv",
  "appName": "ViniTube",
  "version": "2.5.10",
  "description": "YouTube TV na Samsung com bloqueio de anuncio injetado antes do player. Modulo TizenBrew (mods).",
  "packageType": "mods",
  "websiteURL": "https://www.youtube.com/tv",
  "main": "dist/userScript.js",
  "serviceFile": "dist/service.js",
  "evaluateScriptOnDocumentStart": true,
  "keys": [
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind",
    "MediaTrackNext",
    "MediaTrackPrevious",
    "ColorF0Red",
    "ColorF1Green",
    "ColorF2Yellow",
    "ColorF3Blue"
  ],
  "author": "Kai",
  "repository": {
    "url": "https://github.com/ViniACardozo/tizen-piped-tv"
  },
  "license": "GPL-3.0-only"
}